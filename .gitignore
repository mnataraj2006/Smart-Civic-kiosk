# Smart Civic Utility Kiosk — .gitignore

# ── Environment files (NEVER commit these) ────────────────────────────────────
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
.env
.env.*
!.env.example
!backend/.env.example

# ── Node dependencies ─────────────────────────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/

# ── Build outputs ─────────────────────────────────────────────────────────────
frontend/build/
frontend/.cache/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
logs/

# ── OS/Editor ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Misc ──────────────────────────────────────────────────────────────────────
backend/query
